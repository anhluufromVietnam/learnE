# Copy this file to .env and add the server-side Google AI Studio key.
GEMINI_API_KEY=your-google-ai-studio-key

# Optional Ollama configuration.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
# Comma-separated list of available Ollama models.
OLLAMA_MODELS=qwen3:0.6b,qwen3:1.7b,llama3.2:3b,gemma4:31b-cloud
